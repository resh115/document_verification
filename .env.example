# Supabase PostgreSQL - copy the Session Pooler connection details from
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Keep the password URL-encoded when it contains reserved URL characters.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred server-side key name in current Supabase projects.
# A legacy SUPABASE_SERVICE_ROLE_KEY is also accepted for compatibility.
# NEVER expose this value in browser JavaScript or commit it to GitHub.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Private Storage bucket created by database/schema.sql
SUPABASE_STORAGE_BUCKET=documents
